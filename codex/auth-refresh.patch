+
+async fn shared_home_refresh_case(authority: bool) {
+    let home = tempdir().unwrap();
+    write_auth_file(
+        AuthFileParams {
+            openai_api_key: None,
+            chatgpt_plan_type: Some("pro".to_string()),
+            chatgpt_account_id: Some(WORKSPACE_ID_ALLOWED.to_string()),
+        },
+        home.path(),
+    )
+    .unwrap();
+    let auth_file = get_auth_file(home.path());
+    let mut fixture: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&auth_file).unwrap()).unwrap();
+    fixture["tokens"]["account_id"] = json!(WORKSPACE_ID_ALLOWED);
+    std::fs::write(auth_file, serde_json::to_vec(&fixture).unwrap()).unwrap();
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(200)
+            .set_delay(std::time::Duration::from_millis(100))
+            .set_body_json(json!({"access_token":"fixture-rotated-access", "refresh_token":"fixture-rotated-refresh"})))
+        .mount(&server).await;
+    let mut children = Vec::new();
+    for _ in 0..2 {
+        let mut command = tokio::process::Command::new(std::env::current_exe().unwrap());
+        if authority {
+            command.env("CODEX_REFRESH_FIXTURE_AUTHORITY", "1");
+        }
+        let child = command
+            .args([
+                "--exact",
+                "auth::manager::tests::shared_home_refresh_worker",
+            ])
+            .env("CODEX_REFRESH_FIXTURE_HOME", home.path())
+            .env(REFRESH_TOKEN_URL_OVERRIDE_ENV_VAR, server.uri())
+            .env_remove(CODEX_ACCESS_TOKEN_ENV_VAR)
+            .env_remove("OPENAI_API_KEY")
+            .stdout(std::process::Stdio::inherit())
+            .stderr(std::process::Stdio::inherit())
+            .kill_on_drop(true)
+            .spawn()
+            .unwrap();
+        children.push(child);
+    }
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            let ready = std::fs::read_dir(home.path())
+                .unwrap()
+                .filter_map(Result::ok)
+                .filter(|entry| entry.file_name().to_string_lossy().starts_with("ready-"))
+                .count();
+            if ready == 2 {
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("both processes must load the original credentials before refreshing");
+    std::fs::write(home.path().join("start"), b"start").unwrap();
+    for child in &mut children {
+        let status = tokio::time::timeout(std::time::Duration::from_secs(10), child.wait())
+            .await
+            .expect("refresh process must finish")
+            .unwrap();
+        assert!(status.success(), "refresh process must succeed");
+    }
+    assert_eq!(
+        server.received_requests().await.unwrap().len(),
+        1,
+        "shared credentials must rotate only once after a guarded reload"
+    );
+}

