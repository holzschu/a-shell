+        Err(RefreshTokenError::Transient(error)) => {
+            panic!("synthetic refresh transient kind: {:?}", error.kind())
+        }
+        Err(RefreshTokenError::Policy(_)) => panic!("synthetic refresh denied by network policy"),
+    }
