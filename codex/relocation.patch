+/// Resolve a copied default home before any SQLite fast path reads old history.
+#[cfg(any(target_os = "ios", test))]
+pub(super) async fn relocate_metadata(
+    store: &super::LocalThreadStore,
+    metadata: &mut codex_state::ThreadMetadata,
+) -> crate::ThreadStoreResult<()> {
+    if let Some(state) = store.state_db().await {
+        metadata.rollout_path = codex_rollout::relocate_selected_rollout(
+            &state,
+            &store.config.codex_home,
+            metadata.id,
+            &metadata.rollout_path,
+        )
+        .await
+        .map_err(|err| crate::ThreadStoreError::Conflict {
+            message: format!("failed to relocate selected rollout: {err}"),
+        })?;
+    }
+    Ok(())
+}
+
+/// Preserve reachable saved workspaces; map only unavailable old application paths.
+pub(super) fn restored_cwd(saved: &std::path::Path) -> PathBuf {
+    #[cfg(any(target_os = "ios", test))]
+    if let Some(home) = codex_protocol::shell_environment::local_env_var_os("HOME") {
+        return codex_rollout::restored_workspace(saved, std::path::Path::new(&home));
+    }
+    saved.to_path_buf()
+}
+
+#[cfg(any(target_os = "ios", test))]
+pub(super) async fn expand_cwd_filters(
+    store: &super::LocalThreadStore,
+    params: &mut crate::ListThreadsParams,
+) -> crate::ThreadStoreResult<()> {
+    let Some(filters) = params
+        .cwd_filters
+        .as_mut()
+        .filter(|filters| !filters.is_empty())
+    else {
+        return Ok(());
+    };
+    let Some(state) = store.state_db().await else {
+        return Ok(());
+    };
+    let directories = state
+        .list_thread_working_directories(params.archived)
+        .await
+        .map_err(|err| crate::ThreadStoreError::Internal {
+            message: format!("failed to resolve saved workspace filters: {err}"),
+        })?;
+    for old in directories {
+        let current = restored_cwd(&old);
+        if current != old
+            && filters.iter().any(|filter| {
+                codex_rollout::state_db::normalize_cwd_for_state_db(filter) == current
+            })
+            && !filters.contains(&old)
+        {
+            filters.push(old);
+        }
+    }
+    Ok(())
+}
