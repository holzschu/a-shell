+/// Read a named local invocation variable without changing the app environment.
+pub fn local_env_var<K: AsRef<std::ffi::OsStr>>(name: K) -> Result<String, std::env::VarError> {
+    #[cfg(target_os = "ios")]
+    {
+        local_env_var_os(name)
+            .ok_or(std::env::VarError::NotPresent)?
+            .into_string()
+            .map_err(std::env::VarError::NotUnicode)
+    }
+    #[cfg(not(target_os = "ios"))]
+    std::env::var(name)
+}
+
+/// Preserve non-UTF-8 values in the native command's immutable environment snapshot.
+pub fn local_env_var_os<K: AsRef<std::ffi::OsStr>>(name: K) -> Option<std::ffi::OsString> {
+    #[cfg(target_os = "ios")]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        use std::os::unix::ffi::OsStringExt;
+        unsafe extern "C" {
+            fn codex_ios_command_getenv(name: *const std::ffi::c_char) -> *const std::ffi::c_char;
+        }
+        let name = name.as_ref().as_bytes();
+        if name.is_empty() || name.contains(&b'=') {
+            return None;
+        }
+        let name = std::ffi::CString::new(name).ok()?;
+        // The native command lock keeps the snapshot alive until runtime workers join.
+        let value = unsafe { codex_ios_command_getenv(name.as_ptr()) };
+        if value.is_null() {
+            return None;
+        }
+        Some(std::ffi::OsString::from_vec(
+            unsafe { std::ffi::CStr::from_ptr(value) }.to_bytes().to_vec(),
+        ))
+    }
+    #[cfg(not(target_os = "ios"))]
+    std::env::var_os(name)
+}
+
+/// Read the local invocation environment, including embedded command overrides.
+pub fn local_env_vars() -> impl Iterator<Item = (String, String)> {
+    #[cfg(target_os = "ios")]
+    {
+        use std::ffi::OsString;
+        use std::os::unix::ffi::OsStringExt;
+        unsafe extern "C" {
+            fn codex_ios_command_environment() -> *const *const std::ffi::c_char;
+        }
+        let mut entries = unsafe { codex_ios_command_environment() };
+        let mut vars = Vec::new();
+        if entries.is_null() {
+            vars.extend(std::env::vars_os());
+        } else {
+            loop {
+                let entry = unsafe { *entries };
+                if entry.is_null() {
+                    break;
+                }
+                let entry = unsafe { std::ffi::CStr::from_ptr(entry) }.to_bytes();
+                if let Some(split) = entry.iter().position(|byte| *byte == b'=') {
+                    vars.push((OsString::from_vec(entry[..split].to_vec()), OsString::from_vec(entry[split + 1..].to_vec())));
+                }
+                entries = unsafe { entries.add(1) };
+            }
+        }
+        // Like std::env::vars, validate UTF-8 when the consumer iterates.
+        return vars.into_iter().map(|(name, value)| {
+            (name.into_string().expect("native command environment name is not UTF-8"), value.into_string().expect("native command environment value is not UTF-8"))
+        });
+    }
+    #[cfg(not(target_os = "ios"))]
+    std::env::vars()
+}
