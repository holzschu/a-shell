+/// Read iOS commit history through gix without an external Git executable.
+#[cfg(target_os = "ios")]
+pub async fn recent_commits(cwd: &Path, limit: usize) -> Vec<CommitLogEntry> {
+    let cwd = cwd.to_path_buf();
+    tokio::task::spawn_blocking(move || {
+        if !cwd.is_dir() {
+            return None;
+        }
+        let repo = gix::discover(&cwd).ok()?;
+        if repo.is_bare() {
+            return None;
+        }
+        let head = repo.head_commit().ok()?;
+        let commits = head
+            .ancestors()
+            .sorting(gix::revision::walk::Sorting::ByCommitTime(
+                gix::traverse::commit::simple::CommitTimeOrder::NewestFirst,
+            ))
+            .all()
+            .ok()?;
+        // Git log treats an omitted count (the public API's zero) as unlimited.
+        let count = if limit == 0 { usize::MAX } else { limit };
+        let mut entries = Vec::new();
+        for info in commits.take(count) {
+            let info = info.ok()?;
+            let commit = info.object().ok()?;
+            let message = commit.message().ok()?;
+            let summary = message.summary();
+            entries.push(CommitLogEntry {
+                sha: info.id.to_string(),
+                timestamp: commit.time().ok()?.seconds,
+                subject: String::from_utf8_lossy(summary.as_ref()).trim().to_owned(),
+            });
+        }
+        Some(entries)
+    })
+    .await
+    .ok()
+    .flatten()
+    .unwrap_or_default()
+}
