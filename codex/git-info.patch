+/// Collect fetch remotes without launching Git, preserving URL rewriting and sanitization.
+#[cfg(target_os = "ios")]
+pub async fn get_git_remote_urls_assume_git_repo(
+    cwd: &Path,
+) -> Option<BTreeMap<String, SanitizedGitUrl>> {
+    let cwd = cwd.to_path_buf();
+    tokio::task::spawn_blocking(move || {
+        if !cwd.is_dir() {
+            return None;
+        }
+        let repo = gix::discover(&cwd).ok()?;
+        if repo.is_bare() {
+            return None;
+        }
+        let mut remotes = BTreeMap::new();
+        for name in repo.remote_names() {
+            let Ok(remote) = repo.find_remote(name.as_ref()) else {
+                continue;
+            };
+            let Some(url) = remote.url(gix::remote::Direction::Fetch) else {
+                continue;
+            };
+            let url = String::from_utf8(url.to_bstring().into()).ok()?;
+            if let Ok(url) = SanitizedGitUrl::try_from(url.as_str()) {
+                remotes.insert(std::str::from_utf8(name.as_ref()).ok()?.to_owned(), url);
+            }
+        }
+        (!remotes.is_empty()).then_some(remotes)
+    })
+    .await
+    .ok()
+    .flatten()
+}
