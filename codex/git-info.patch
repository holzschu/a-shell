+/// Read iOS repository metadata through the existing gix library without a child process.
+#[cfg(target_os = "ios")]
+pub async fn collect_git_info(cwd: &Path) -> Option<GitInfo> {
+    let cwd = cwd.to_path_buf();
+    // Keep synchronous Git config/reference I/O off the async runtime workers.
+    tokio::task::spawn_blocking(move || {
+        if !cwd.is_dir() {
+            return None;
+        }
+        let repo = gix::discover(&cwd).ok()?;
+        // Match safe.bareRepository=explicit for implicit cwd discovery.
+        if repo.is_bare() {
+            return None;
+        }
+        let head = repo.head().ok();
+        let commit_hash = head
+            .as_ref()
+            .and_then(|head| head.id())
+            .map(|id| GitSha::new(&id.to_string()));
+        let branch = head
+            .as_ref()
+            .filter(|head| !head.is_unborn())
+            .and_then(|head| {
+                std::str::from_utf8(head.referent_name()?.shorten())
+                    .ok()
+                    .map(str::to_owned)
+            });
+        let repository_url = repo.find_remote("origin").ok().and_then(|remote| {
+            let url = remote.url(gix::remote::Direction::Fetch)?;
+            let url = String::from_utf8(url.to_bstring().into()).ok()?;
+            SanitizedGitUrl::try_from(url.as_str()).ok()
+        });
+        Some(GitInfo {
+            commit_hash,
+            branch,
+            repository_url,
+        })
+    })
+    .await
+    .ok()
+    .flatten()
 }
 
