+/// UIKit supplies PNG bytes; image decoding and temporary-file handling stay upstream.
+#[cfg(target_os = "ios")]
+pub fn paste_image_as_png() -> Result<(Vec<u8>, PastedImageInfo), PasteImageError> {
+    unsafe extern "C" {
+        fn codex_ios_clipboard_png(length: *mut usize) -> *mut u8;
+    }
+    let mut length = 0;
+    let pointer = unsafe { codex_ios_clipboard_png(&mut length) };
+    if pointer.is_null() {
+        return Err(PasteImageError::NoImage(
+            "iOS clipboard contains no image".into(),
+        ));
+    }
+    let png = unsafe { std::slice::from_raw_parts(pointer, length).to_vec() };
+    unsafe { libc::free(pointer.cast()) };
+    let image = image::load_from_memory(&png)
+        .map_err(|error| PasteImageError::EncodeFailed(error.to_string()))?;
+    Ok((
+        png,
+        PastedImageInfo {
+            width: image.width(),
+            height: image.height(),
+            encoded_format: EncodedImageFormat::Png,
+        },
+    ))
+}
