 mod absolutize;
 mod system_aliases;
+
+/// The app's private temporary directory, independent of the command's TMPDIR.
+#[cfg(target_os = "ios")]
+pub fn ios_private_temp_dir() -> std::io::Result<PathBuf> {
+    use std::ffi::c_char;
+    use std::ffi::c_int;
+    use std::os::unix::ffi::OsStringExt;
+
+    const _CS_DARWIN_USER_TEMP_DIR: c_int = 65537;
+    unsafe extern "C" {
+        fn confstr(name: c_int, buf: *mut c_char, len: usize) -> usize;
+    }
+
+    let mut buffer = vec![0; 1024];
+    // SAFETY: confstr can write at most buffer.len() bytes to this writable buffer.
+    let length = unsafe {
+        confstr(
+            _CS_DARWIN_USER_TEMP_DIR,
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+        )
+    };
+    if length <= 1 || length > buffer.len() {
+        return Err(std::io::Error::other(
+            "could not locate the iOS private temporary directory",
+        ));
+    }
+    buffer.truncate(length - 1);
+    Ok(PathBuf::from(std::ffi::OsString::from_vec(buffer)))
+}
+
+/// Keep service locks out of App Group storage so iOS can suspend a-Shell (0xDEAD10CC).
+/// The embedded command runs one Codex invocation at a time in the app process.
+pub fn ashell_service_lock_dir(_default: &Path) -> std::io::Result<PathBuf> {
+    #[cfg(target_os = "ios")]
+    {
+        Ok(ios_private_temp_dir()?.join("ashell-codex-locks"))
+    }
+
+    #[cfg(not(target_os = "ios"))]
+    {
+        Ok(_default.to_path_buf())
+    }
+}
 
