+#[cfg(target_os = "ios")]
+fn command_var(name: &str) -> Result<String, std::env::VarError> {
+    use std::os::unix::ffi::OsStringExt;
+    unsafe extern "C" {
+        fn codex_ios_command_getenv(name: *const std::ffi::c_char) -> *const std::ffi::c_char;
+    }
+    let name = std::ffi::CString::new(name).map_err(|_| std::env::VarError::NotPresent)?;
+    let value = unsafe { codex_ios_command_getenv(name.as_ptr()) };
+    if value.is_null() {
+        return Err(std::env::VarError::NotPresent);
+    }
+    let bytes = unsafe { std::ffi::CStr::from_ptr(value) }.to_bytes().to_vec();
+    String::from_utf8(bytes).map_err(|error| {
+        std::env::VarError::NotUnicode(std::ffi::OsString::from_vec(error.into_bytes()))
+    })
 }
 
