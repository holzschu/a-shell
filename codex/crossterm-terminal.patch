+// Borrow the command-captured tty; the host keeps it alive until reader reset.
+#[cfg(target_os = "ios")]
+pub fn tty_fd() -> io::Result<FileDesc<'static>> {
+    unsafe extern "C" {
+        fn codex_ios_terminal_input() -> i32;
+    }
+    let fd = unsafe { codex_ios_terminal_input() };
+    if fd < 0 {
+        return Err(io::Error::from_raw_os_error(25)); // ENOTTY
+    }
+    #[cfg(feature = "libc")]
+    { Ok(FileDesc::new(fd, false)) }
+    #[cfg(not(feature = "libc"))]
+    {
+        // The embedded entry point resets the reader before releasing host input.
+        Ok(FileDesc::Borrowed(unsafe { BorrowedFd::borrow_raw(fd) }))
+    }
+}
