+//! Cancellable stdio owned by one embedded command, without global stdio locks.
+
+use std::fs::File;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::os::fd::AsRawFd;
+use std::os::fd::BorrowedFd;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::Context;
+use std::task::Poll;
+use tokio::io::AsyncRead;
+use tokio::io::AsyncWrite;
+use tokio::io::ReadBuf;
+use tokio::io::unix::AsyncFd;
+
+// Xcode iOS SDK sys/fcntl.h; libc 0.2.186 does not export these Darwin commands.
+const F_SETNOSIGPIPE: libc::c_int = 73;
+const F_GETNOSIGPIPE: libc::c_int = 74;
+
+struct Descriptors {
+    files: [File; 2],
+    original_flags: [i32; 2],
+    // Sockets use per-write MSG_NOSIGNAL and keep their socket policy unchanged.
+    original_no_sigpipe: Option<i32>,
+}
+
+impl Drop for Descriptors {
+    fn drop(&mut self) {
+        for (file, flags) in self.files.iter().zip(self.original_flags) {
+            // Duplicates share file status flags with the caller. Restore only
+            // after both I/O tasks have released their descriptors.
+            if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_SETFL, flags) } == -1 {
+                eprintln!(
+                    "Cannot restore app-server stdio flags: {}",
+                    io::Error::last_os_error()
+                );
+            }
+        }
+        if let Some(original) = self.original_no_sigpipe {
+            if unsafe { libc::fcntl(self.files[1].as_raw_fd(), F_SETNOSIGPIPE, original) } == -1 {
+                eprintln!(
+                    "Cannot restore app-server SIGPIPE flag: {}",
+                    io::Error::last_os_error()
+                );
+            }
+        }
+    }
+}
+
+struct Descriptor {
+    descriptors: Arc<Descriptors>,
+    index: usize,
+}
+
+impl Descriptor {
+    fn file(&self) -> &File {
+        &self.descriptors.files[self.index]
+    }
+}
+
+impl AsRawFd for Descriptor {
+    fn as_raw_fd(&self) -> i32 {
+        self.file().as_raw_fd()
+    }
+}
+
+/// Invocation-owned stdin/stdout with shared restoration after both are released.
+pub struct OwnedStdio {
+    fd: AsyncFd<Descriptor>,
+}
+
+impl OwnedStdio {
+    /// Duplicate the caller descriptors and snapshot both before enabling nonblocking I/O.
+    pub fn pair() -> io::Result<(Self, Self)> {
+        // The native command wrapper retains the caller's stdio while this runs.
+        let files = unsafe {
+            [
+                File::from(BorrowedFd::borrow_raw(0).try_clone_to_owned()?),
+                File::from(BorrowedFd::borrow_raw(1).try_clone_to_owned()?),
+            ]
+        };
+        let mut original_flags = [0; 2];
+        // Snapshot both before changing either: stdin and stdout may be dup'ed
+        // from the same PTY and therefore share their file status flags.
+        for (file, flags) in files.iter().zip(&mut original_flags) {
+            *flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFL) };
+            if *flags == -1 {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        let mut output_stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+        if unsafe { libc::fstat(files[1].as_raw_fd(), output_stat.as_mut_ptr()) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        let output_is_socket =
+            unsafe { output_stat.assume_init() }.st_mode & libc::S_IFMT == libc::S_IFSOCK;
+        let original_no_sigpipe = if output_is_socket {
+            None
+        } else {
+            let original = unsafe { libc::fcntl(files[1].as_raw_fd(), F_GETNOSIGPIPE) };
+            if original == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            Some(original)
+        };
+        let descriptors = Arc::new(Descriptors {
+            files,
+            original_flags,
+            original_no_sigpipe,
+        });
+        // Use Darwin's descriptor policy, not a process-wide signal handler or
+        // a thread mask that an asynchronous task could leave on another worker.
+        // A socket that has shut down rejects socket-option restoration (EINVAL).
+        // Use MSG_NOSIGNAL there; pipes and PTYs retain their descriptor policy.
+        if descriptors.original_no_sigpipe.is_some()
+            && unsafe { libc::fcntl(descriptors.files[1].as_raw_fd(), F_SETNOSIGPIPE, 1) } == -1
+        {
+            return Err(io::Error::last_os_error());
+        }
+        for (file, flags) in descriptors.files.iter().zip(original_flags) {
+            if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) }
+                == -1
+            {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        let input = Self {
+            fd: AsyncFd::new(Descriptor {
+                descriptors: Arc::clone(&descriptors),
+                index: 0,
+            })?,
+        };
+        let output = Self {
+            fd: AsyncFd::new(Descriptor {
+                descriptors,
+                index: 1,
+            })?,
+        };
+        Ok((input, output))
+    }
+}
+
+impl AsyncRead for OwnedStdio {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buffer: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        if buffer.remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+        loop {
+            let mut ready = std::task::ready!(self.fd.poll_read_ready(cx))?;
+            match ready.try_io(|fd| fd.get_ref().file().read(buffer.initialize_unfilled())) {
+                Ok(Ok(count)) => {
+                    buffer.advance(count);
+                    return Poll::Ready(Ok(()));
+                }
+                Ok(Err(error)) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Ok(Err(error)) => return Poll::Ready(Err(error)),
+                Err(_) => continue,
+            }
+        }
+    }
+}
+
+impl AsyncWrite for OwnedStdio {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        bytes: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        if bytes.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+        loop {
+            let mut ready = std::task::ready!(self.fd.poll_write_ready(cx))?;
+            match ready.try_io(|fd| {
+                let descriptor = fd.get_ref();
+                if descriptor.descriptors.original_no_sigpipe.is_none() {
+                    let count = unsafe {
+                        libc::send(
+                            descriptor.as_raw_fd(),
+                            bytes.as_ptr().cast(),
+                            bytes.len(),
+                            libc::MSG_NOSIGNAL,
+                        )
+                    };
+                    if count == -1 {
+                        Err(io::Error::last_os_error())
+                    } else {
+                        Ok(count as usize)
+                    }
+                } else {
+                    descriptor.file().write(bytes)
+                }
+            }) {
+                Ok(Ok(count)) => return Poll::Ready(Ok(count)),
+                Ok(Err(error)) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Ok(Err(error)) => return Poll::Ready(Err(error)),
+                Err(_) => continue,
+            }
+        }
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        // Writes go directly to the descriptor; this adapter has no buffer.
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        // The caller owns the underlying stream. Closing its write side would
+        // affect other duplicated descriptors; dropping only releases ours.
+        Poll::Ready(Ok(()))
+    }
+}
