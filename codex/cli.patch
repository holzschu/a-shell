+/// Run the unchanged CLI dispatcher with argv supplied by the iOS command host.
+#[cfg(target_os = "ios")]
+pub async fn run_embedded(args: Vec<String>, paths: Arg0DispatchPaths) -> anyhow::Result<i32> {
+    codex_build_info::initialize!();
+    let mut cli = match MultitoolCli::try_parse_from(args) {
+        Ok(cli) => cli,
+        Err(error) => {
+            let status = error.exit_code();
+            error.print()?;
+            return Ok(status);
+        }
+    };
+    // Local iOS runs belong to the app's lifetime, not a forked background daemon.
+    let local_interactive = cli.remote.remote.is_none()
+        && match &cli.subcommand {
+            None => true,
+            Some(Subcommand::Resume(command)) => command.remote.remote.is_none(),
+            Some(Subcommand::Fork(command)) => command.remote.remote.is_none(),
+            _ => false,
+        };
+    if local_interactive {
+        cli.interactive.no_daemon = true;
+    }
+    Box::pin(cli_main(paths, false, cli)).await?;
+    Ok(0)
+}
+
+/// Classify terminal ownership using the upstream argument parser.
+#[cfg(target_os = "ios")]
+pub fn embedded_uses_tui(args: Vec<String>) -> bool {
+    MultitoolCli::try_parse_from(args).is_ok_and(|cli| match cli.subcommand {
+        None
+        | Some(Subcommand::Agents(_))
+        | Some(Subcommand::Resume(_))
+        | Some(Subcommand::Fork(_)) => true,
+        Some(Subcommand::Cloud(command)) => command.command.is_none(),
+        _ => false,
+    })
+}
