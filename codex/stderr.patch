+//! Command streams for CLI consumers and embedded iOS invocations.
+#[cfg(target_os = "ios")]
+#[path = "stderr_ios.rs"]
+mod ios;
+#[cfg(target_os = "ios")]
+pub use ios::{capture_stderr, stderr};
+#[cfg(not(target_os = "ios"))]
+pub use std::io::stderr;
+#[cfg(not(target_os = "ios"))]
+pub use std::io::stdin;
+
+#[cfg(target_os = "ios")]
+pub struct Stdin;
+
+#[cfg(target_os = "ios")]
+pub fn stdin() -> Stdin {
+    Stdin
+}
+
+#[cfg(target_os = "ios")]
+impl std::io::Read for Stdin {
+    fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+        unsafe extern "C" {
+            fn codex_ios_read_stdin(bytes: *mut std::ffi::c_void, length: usize) -> isize;
+        }
+        let count = unsafe { codex_ios_read_stdin(bytes.as_mut_ptr().cast(), bytes.len()) };
+        if count < 0 {
+            Err(std::io::Error::last_os_error())
+        } else {
+            Ok(count as usize)
+        }
+    }
+}
+
+#[cfg(target_os = "ios")]
+impl Stdin {
+    pub fn read_line(&mut self, line: &mut String) -> std::io::Result<usize> {
+        use std::io::BufRead;
+        // Each prompt owns its reader; do not consume the next prompt's bytes.
+        std::io::BufReader::with_capacity(1, self).read_line(line)
+    }
+}
