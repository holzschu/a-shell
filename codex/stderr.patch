+//! Invocation-owned diagnostics; the surrounding app retains process stderr.
+use std::fs::File;
+use std::io::{self, Write};
+use std::os::fd::BorrowedFd;
+use std::sync::{Mutex, MutexGuard};
+
+static OUTPUT: Mutex<Option<File>> = Mutex::new(None);
+
+/// Keep the duplicated stream alive until all command workers have joined.
+pub struct StderrGuard {
+    _private: (),
+}
+
+pub fn capture_stderr(fd: BorrowedFd<'_>) -> io::Result<StderrGuard> {
+    let mut output = OUTPUT.lock().unwrap_or_else(|error| error.into_inner());
+    if output.is_some() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "Codex stderr is already captured",
+        ));
+    }
+    *output = Some(File::from(fd.try_clone_to_owned()?));
+    Ok(StderrGuard { _private: () })
+}
+
+impl Drop for StderrGuard {
+    fn drop(&mut self) {
+        OUTPUT
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .take();
+    }
+}
+
+pub struct Stderr;
+pub struct StderrLock<'a>(MutexGuard<'a, Option<File>>);
+
+pub fn stderr() -> Stderr {
+    Stderr
+}
+
+impl Stderr {
+    pub fn is_terminal(&self) -> bool {
+        #[cfg(target_os = "ios")]
+        {
+            unsafe extern "C" {
+                fn codex_ios_terminal_isatty(fd: i32) -> i32;
+            }
+            unsafe { codex_ios_terminal_isatty(2) != 0 }
+        }
+        #[cfg(not(target_os = "ios"))]
+        {
+            use std::io::IsTerminal;
+            OUTPUT
+                .lock()
+                .unwrap_or_else(|error| error.into_inner())
+                .as_ref()
+                .is_some_and(IsTerminal::is_terminal)
+        }
+    }
+
+    pub fn lock(&self) -> StderrLock<'static> {
+        StderrLock(OUTPUT.lock().unwrap_or_else(|error| error.into_inner()))
+    }
+}
+
+impl Write for StderrLock<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0
+            .as_mut()
+            .ok_or_else(|| {
+                io::Error::new(io::ErrorKind::NotConnected, "Codex stderr is not captured")
+            })?
+            .write(bytes)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.0
+            .as_mut()
+            .ok_or_else(|| {
+                io::Error::new(io::ErrorKind::NotConnected, "Codex stderr is not captured")
+            })?
+            .flush()
+    }
+}
+
+impl Write for Stderr {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.lock().write(bytes)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.lock().flush()
+    }
+
+    fn write_fmt(&mut self, args: std::fmt::Arguments<'_>) -> io::Result<()> {
+        self.lock().write_fmt(args)
+    }
+}
