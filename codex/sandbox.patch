+
+/// Validate restrictions before configuration or execution can claim enforcement.
+#[cfg(target_os = "ios")]
+pub fn validate_ios_permission_profile(
+    profile: &PermissionProfile,
+) -> Result<(), SandboxTransformError> {
+    let (file_system, network) = profile.to_runtime_permissions();
+    if file_system.has_full_disk_read_access()
+        && file_system.has_full_disk_write_access()
+        && network.is_enabled()
+    {
+        Ok(())
+    } else {
+        Err(SandboxTransformError::IosSandboxUnavailable)
+    }
+}
