diff --git i/pico/osdep/raw.c w/pico/osdep/raw.c
index 96f630f..079b7a0 100644
--- i/pico/osdep/raw.c
+++ w/pico/osdep/raw.c
@@ -65,6 +65,13 @@ static short _inraw = 0;
 int
 Raw(int state)
 {
+#ifdef PICO_IOS
+    if(state && !_inraw) ios_startInteractive();
+    if(!state && _inraw) ios_stopInteractive();
+    _inraw = state != 0;
+    return 0;
+#else
+
     /** state is either ON or OFF, as indicated by call **/
     /* Check return code only on first call. If it fails we're done for and
        if it goes OK the others will probably go OK too. */
@@ -167,6 +174,7 @@ Raw(int state)
     }
 
     return(0);
+#endif
 }
 
 
