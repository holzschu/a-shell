 static size_t rule_dir_depth;
 
+#ifdef OPENRSYNC_IOS
+static void
+rules_discard(struct ruleset *ruleset)
+{
+	for (size_t i = 0; i < ruleset->numrules; i++) {
+		struct rule *rule = &ruleset->rules[i];
+		if (rule->type == RULE_DIR_MERGE) {
+			struct merge_rule *merge;
+			while ((merge = TAILQ_FIRST(&rule->merge_rule_chain)) != NULL) {
+				TAILQ_REMOVE(&rule->merge_rule_chain, merge, entries);
+				rules_discard(merge->ruleset);
+				free(merge->ruleset);
+				free(merge->path);
+				free(merge);
+			}
+		}
+		free(rule->pattern);
+	}
+	free(ruleset->rules);
+}
+
+void
+rules_reset(void)
+{
+	rules_discard(&global_ruleset);
+	memset(&global_ruleset, 0, sizeof(global_ruleset));
+	global_ruleset.lclear = (size_t)-1;
+	rule_base[0] = '\0';
+	rule_base_cwdend = NULL;
+	rule_dir_depth = 0;
+}
+#endif
