+	FILE *old_input = NULL, *old_output = NULL, *old_error = NULL;
+	ios_activateChildStreams(&old_input, &old_output, &old_error);
+	if (thread_stdin != saved_input) fclose(thread_stdin);
+	if (thread_stdout != saved_output) fclose(thread_stdout);
+	thread_stdin = saved_input;
+	thread_stdout = saved_output;
+	thread_stderr = saved_error;
+	if (cleanup->fd >= 0) shutdown(cleanup->fd, SHUT_RDWR);
+	if (cleanup->child >= 0) {
+		int status;
+		ios_full_waitpid(cleanup->child, &status, 0);
+	}
+	if (cleanup->fd >= 0) close(cleanup->fd);
+	if (cleanup->peer >= 0) close(cleanup->peer);
+	if (cleanup->input >= 0) close(cleanup->input);
+	if (cleanup->output >= 0) close(cleanup->output);
+	if (cleanup->args != NULL) {
+		for (int i = 0; cleanup->args[i] != NULL; i++)
+			free(cleanup->args[i]);
+		free(cleanup->args);
+	}
+	if (cleanup->fargs != NULL) fargs_free(cleanup->fargs);
+}
