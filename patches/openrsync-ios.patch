+ios_close_transport(void *opaque)
+{
+	struct ios_transport_cleanup *cleanup = opaque;
+	struct sigaction current;
+	if (cleanup->installed && sigaction(SIGINT, NULL, &current) == 0 &&
+	    current.sa_handler == ios_interrupt)
+		sigaction(SIGINT, &cleanup->previous, NULL);
