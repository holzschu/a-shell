+std::unique_ptr<CommonEnvironmentSetup> CommonEnvironmentSetup::CreateForCommand(
+    MultiIsolatePlatform* platform,
+    std::vector<std::string>* errors,
+    std::vector<std::string> args,
+    EnvironmentFlags::Flags flags,
+    int* exit_code) {
+  auto options = std::make_shared<PerIsolateOptions>();
+  std::vector<std::string> exec_args, v8_args;
+  // The parser is stock; neither per_process::cli_options nor V8 flags change.
+  // Serialize the parser only, not bootstrap or either command's event loop.
+  {
+    Mutex::ScopedLock lock(per_process::cli_options_mutex);
+    options_parser::Parse(&args, &exec_args, &v8_args, options.get(),
+                          kDisallowedInEnvvar, errors);
+  }
+  *exit_code = 9;
+  if (!errors->empty()) return nullptr;
+  if (v8_args.size() > 1) {
+    errors->emplace_back("V8 options are unavailable in embedded commands.");
+    return nullptr;
+  }
+  *exit_code = 1;
+  auto ret = std::unique_ptr<CommonEnvironmentSetup>(new CommonEnvironmentSetup(
+      platform, errors, nullptr, 0,
+      [&](const CommonEnvironmentSetup* setup) -> Environment* {
+        return CreateEnvironment(setup->isolate_data(), setup->context(),
+                                 args, exec_args, flags);
+      }, nullptr, std::move(options)));
+  if (!errors->empty()) ret.reset();
+  return ret;
+}
