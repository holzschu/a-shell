--- a/deps/uv/src/unix/process.c
+++ b/deps/uv/src/unix/process.c
@@ -953,10 +953,27 @@
 }
 #endif /* ISN'T TARGET_OS_TV || TARGET_OS_WATCH */
 
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+extern int AShellUVSpawn(uv_loop_t*, uv_process_t*, const uv_process_options_t*);
+extern int AShellUVKill(uv_process_t*, int);
+extern void AShellUVClose(uv_process_t*);
+void AShellUVExit(uv_process_t* process, int status) {
+  uv__handle_stop(process);
+  if (process->exit_cb != NULL) process->exit_cb(process, status, 0);
+}
+#endif
+
 int uv_spawn(uv_loop_t* loop,
              uv_process_t* process,
              const uv_process_options_t* options) {
-#if defined(__APPLE__) && (TARGET_OS_TV || TARGET_OS_WATCH)
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+  uv__handle_init(loop, (uv_handle_t*)process, UV_PROCESS);
+  uv__queue_init(&process->queue);
+  process->status = 0;
+  int err = AShellUVSpawn(loop, process, options);
+  if (err == 0) uv__handle_start(process);
+  return err;
+#elif defined(__APPLE__) && (TARGET_OS_TV || TARGET_OS_WATCH)
   /* fork is marked __WATCHOS_PROHIBITED __TVOS_PROHIBITED. */
   return UV_ENOSYS;
