+// Native callers register their exact streams until command cleanup completes.
+typedef struct ashell_owned_streams {
+    FILE *streams[3];
+    unsigned active;
+    pthread_cond_t idle;
+    struct ashell_owned_streams *next;
+} ashell_owned_streams;
+static pthread_mutex_t ashell_stream_mutex = PTHREAD_MUTEX_INITIALIZER;
+static ashell_owned_streams *ashell_native_streams;
+
+int ashell_register_owned_streams(FILE *in, FILE *out, FILE *err, void **registration) {
+    if (!in || !out || !err || !registration || *registration) return EINVAL;
+    ashell_owned_streams *entry = malloc(sizeof(*entry));
+    if (!entry) return ENOMEM;
+    int error = pthread_cond_init(&entry->idle, NULL);
+    if (error) { free(entry); return error; }
+    entry->active = 0;
+    entry->streams[0] = in;
+    entry->streams[1] = out;
+    entry->streams[2] = err;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    entry->next = ashell_native_streams;
+    ashell_native_streams = entry;
+    pthread_mutex_unlock(&ashell_stream_mutex);
+    *registration = entry;
+    return 0;
+}
+
+// The owner must wait for actual command completion before unregistering or closing FILEs.
+void ashell_unregister_owned_streams(void **registration) {
+    if (!registration || !*registration) return;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    ashell_owned_streams **entry = &ashell_native_streams;
+    while (*entry && *entry != *registration) entry = &(*entry)->next;
+    if (*entry) {
+        ashell_owned_streams *removed = *entry;
+        *entry = removed->next;
+        pthread_cond_destroy(&removed->idle);
+        free(removed);
+    }
+    pthread_mutex_unlock(&ashell_stream_mutex);
+    *registration = NULL;
+}
+
+// PID release happens before cleanup's final session/context accesses. Track native
+// command entry through the end of run_function, not just the stock fake PID slot.
+static ashell_owned_streams *ashell_enter_owned_command(FILE *in, FILE *out, FILE *err) {
+    ashell_owned_streams *found = NULL;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    for (ashell_owned_streams *entry = ashell_native_streams; entry && !found; entry = entry->next)
+        for (int i = 0; i < 3; i++)
+            if (entry->streams[i] == in || entry->streams[i] == out || entry->streams[i] == err)
+                found = entry;
+    if (found) found->active++;
+    pthread_mutex_unlock(&ashell_stream_mutex);
+    return found;
+}
+
+static void ashell_leave_owned_command(ashell_owned_streams *entry) {
+    if (!entry) return;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    if (--entry->active == 0) pthread_cond_broadcast(&entry->idle);
+    pthread_mutex_unlock(&ashell_stream_mutex);
+}
+
+// Call after ios_waitpid; allocated-but-not-started commands must have entered first.
+void ashell_wait_owned_streams(void *registration) {
+    ashell_owned_streams *entry = registration;
+    if (!entry) return;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    while (entry->active) pthread_cond_wait(&entry->idle, &ashell_stream_mutex);
+    pthread_mutex_unlock(&ashell_stream_mutex);
+}
+
+// Only exact owned streams are protected; nested command pipes retain stock cleanup.
+static bool ashell_host_owns_stream(FILE *stream) {
+    if (!stream) return false;
+    bool found = false;
+    pthread_mutex_lock(&ashell_stream_mutex);
+    for (ashell_owned_streams *entry = ashell_native_streams; entry && !found; entry = entry->next)
+        for (int i = 0; i < 3; i++)
+            if (stream == entry->streams[i]) found = true;
+    pthread_mutex_unlock(&ashell_stream_mutex);
+    return found;
+}
