+#[cfg(target_os = "ios")]
+pub fn tty_fd() -> io::Result<FileDesc<'static>> {
+    extern "C" { fn hx_io_fd(index: i32) -> i32; }
+    let fd = unsafe { hx_io_fd(0) };
+    if fd < 0 { return Err(io::Error::new(io::ErrorKind::NotConnected, "Helix input is closed")); }
+    #[cfg(feature = "libc")]
+    return Ok(FileDesc::new(fd, false));
+    #[cfg(not(feature = "libc"))]
+    return Ok(FileDesc::Borrowed(unsafe { BorrowedFd::borrow_raw(fd) }));
+}
