+#[cfg(target_os = "ios")]
+#[no_mangle]
+pub unsafe extern "C" fn hx_embedded_run(argc: i32, argv: *const *const std::ffi::c_char) -> i32 {
+    let args: Vec<String> = (0..argc).map(|i| std::ffi::CStr::from_ptr(*argv.add(i as usize)).to_string_lossy().into_owned()).collect();
+    match std::thread::Builder::new().name("helix-ios".into()).stack_size(16 * 1024 * 1024).spawn(move || {
+        crate::args::IOS_ARGS.with(|slot| *slot.borrow_mut() = args);
