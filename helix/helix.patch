new file mode 100644
index 0000000..7cfdaa9
--- /dev/null
+++ w/helix-stdx/src/ios_io.rs
@@ -0,0 +1,18 @@
+use std::{fs::File, io::{self, Read, Write}, os::fd::{AsRawFd, RawFd, FromRawFd}};
+extern "C" { fn hx_io_fd(index: i32) -> i32; fn dup(fd: i32) -> i32; }
+pub struct Stream(File);
+impl Stream { pub fn lock(&self) -> File { self.0.try_clone().expect("duplicate Helix stream") } }
+impl AsRawFd for Stream { fn as_raw_fd(&self) -> RawFd { self.0.as_raw_fd() } }
+impl Read for Stream { fn read(&mut self, data: &mut [u8]) -> io::Result<usize> { self.0.read(data) } }
+impl Write for Stream {
+    fn write(&mut self, data: &[u8]) -> io::Result<usize> { self.0.write(data) }
+    fn flush(&mut self) -> io::Result<()> { self.0.flush() }
+}
+fn stream(index: i32) -> Stream {
+    let fd = unsafe { dup(hx_io_fd(index)) };
+    assert!(fd >= 0, "cannot duplicate owned Helix stream");
+    Stream(unsafe { File::from_raw_fd(fd) })
+}
+pub fn stdin() -> Stream { stream(0) }
+pub fn stdout() -> Stream { stream(1) }
+pub fn stderr() -> Stream { stream(2) }
