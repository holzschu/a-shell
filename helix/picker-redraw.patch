--- /dev/null
+++ b/helix-event/tests/redraw.rs
@@ -0,0 +1,53 @@
+#![cfg(feature = "integration_test")]
+
+use std::{thread, time::Duration};
+
+use tokio::runtime::Runtime;
+
+fn notified(editor: &Runtime, wait: Duration) -> bool {
+    editor.block_on(async {
+        tokio::time::timeout(wait, helix_event::redraw_requested())
+            .await
+            .is_ok()
+    })
+}
+
+#[test]
+fn background_redraw_reaches_its_editor() {
+    let first = Runtime::new().unwrap();
+    let second = Runtime::new().unwrap();
+    let quiet = Duration::from_millis(20);
+    let patient = Duration::from_secs(1);
+
+    // Injector guard built in `first`, cloned and dropped on a worker thread.
+    let guard = first.block_on(async { helix_event::RequestRedrawOnDrop::default() });
+    thread::spawn(move || {
+        let cloned = guard.clone();
+        drop(guard);
+        drop(cloned);
+    })
+    .join()
+    .expect("background redraw panicked");
+    assert!(
+        !notified(&second, quiet),
+        "redraw leaked into another editor"
+    );
+    assert!(
+        notified(&first, patient),
+        "owning editor did not receive redraw"
+    );
+
+    // Matcher callback built in `second`, called on a worker thread.
+    let callback = second.block_on(async { helix_event::redraw_handle() });
+    thread::spawn(callback)
+        .join()
+        .expect("matcher redraw panicked");
+    assert!(
+        !notified(&first, quiet),
+        "redraw leaked into another editor"
+    );
+    assert!(
+        notified(&second, patient),
+        "matcher did not notify its owning editor"
+    );
+}
