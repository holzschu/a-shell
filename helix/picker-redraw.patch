+/// Capture the owning editor's notifier before crossing a non-Tokio thread boundary.
+/// Embedded iOS invocations have runtime-local state; looking it up on a picker
+/// worker panics and restores the terminal while the editor is still running.
+pub fn redraw_handle() -> impl Fn() + Send + Sync + 'static {
+    let notify = &*REDRAW_NOTIFY;
+    move || notify.notify_one()
+}
+
+/// Requests a redraw of the owning editor when dropped, including on worker threads.
+#[derive(Clone)]
+pub struct RequestRedrawOnDrop(&'static Notify);
+
+impl Default for RequestRedrawOnDrop {
+    fn default() -> Self {
+        Self(&REDRAW_NOTIFY)
+    }
+}
 
 impl Drop for RequestRedrawOnDrop {
     fn drop(&mut self) {
-        request_redraw();
+        self.0.notify_one();
     }
 }
