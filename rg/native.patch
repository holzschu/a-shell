+// Supply command argv instead of application argv.
+fn embedded_args() -> Vec<std::ffi::OsString> {
+    embedded::context().args.clone()
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rg_embedded_run(
+    argc: i32,
+    argv: *const *const std::ffi::c_char,
+    input: i32,
+    output: i32,
+    error: i32,
+    input_is_terminal: i32,
+    output_is_terminal: i32,
+) -> i32 {
+    use std::os::unix::ffi::OsStringExt;
+    if argc < 1 || argv.is_null() {
+        return 2;
+    }
+    let args = (1..argc as usize)
+        .map(|i| {
+            let bytes =
+                unsafe { std::ffi::CStr::from_ptr(*argv.add(i)) }.to_bytes();
+            std::ffi::OsString::from_vec(bytes.to_vec())
+        })
+        .collect();
+    let context = match embedded::new(
+        args,
+        input,
+        output,
+        error,
+        input_is_terminal != 0,
+        output_is_terminal != 0,
+    ) {
+        Ok(context) => context,
+        Err(_) => return 2,
+    };
+    let _guard = embedded::enter(context);
+    let result = std::panic::catch_unwind(main);
+    match result {
+        Ok(status) => status,
+        Err(payload) => payload.downcast_ref::<i32>().copied().unwrap_or(2),
+    }
+}
