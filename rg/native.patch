+//! Invocation-owned streams and state for the embedded command.
+use std::{
+    cell::RefCell,
+    fs::File,
+    io::{self, Write},
+    os::{fd::FromRawFd, unix::fs::FileTypeExt},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+    },
+};
+
+unsafe extern "C" {
+    fn rg_dup_stream(fd: i32) -> i32;
+}
+
+pub(crate) struct Context {
+    pub(crate) args: Vec<std::ffi::OsString>,
+    streams: [File; 3],
+    stdin_is_terminal: bool,
+    stdout_is_terminal: bool,
+    pub(crate) output_lock: Mutex<()>,
+    pub(crate) messages: AtomicBool,
+    pub(crate) ignore_messages: AtomicBool,
+    pub(crate) errored: AtomicBool,
+    pub(crate) log_level: AtomicUsize,
+}
+thread_local! {
+    static CURRENT: RefCell<Option<Arc<Context>>> = const { RefCell::new(None) };
+}
+pub(crate) struct Guard(Option<Arc<Context>>);
+impl Drop for Guard {
+    fn drop(&mut self) {
+        CURRENT.with(|slot| *slot.borrow_mut() = self.0.take());
+    }
+}
+pub(crate) fn enter(context: Arc<Context>) -> Guard {
+    Guard(CURRENT.with(|slot| slot.borrow_mut().replace(context)))
+}
+pub(crate) fn context() -> Arc<Context> {
+    CURRENT.with(|slot| slot.borrow().as_ref().unwrap().clone())
+}
+pub(crate) fn logging(level: log::Level) -> bool {
+    CURRENT.with(|slot| {
+        slot.borrow().as_ref().is_some_and(|c| {
+            level as usize <= c.log_level.load(Ordering::Relaxed)
+        })
+    })
+}
+pub(crate) fn new(
+    args: Vec<std::ffi::OsString>,
+    input: i32,
+    output: i32,
+    error: i32,
+    stdin_is_terminal: bool,
+    stdout_is_terminal: bool,
+) -> io::Result<Arc<Context>> {
+    fn duplicate(fd: i32) -> io::Result<File> {
+        let copy = unsafe { rg_dup_stream(fd) };
+        if copy < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // The adapter returns an owned dup; File closes only that copy.
+        Ok(unsafe { File::from_raw_fd(copy) })
+    }
+    let streams = [duplicate(input)?, duplicate(output)?, duplicate(error)?];
+    // A redirected regular file is never a terminal, even if the host session says so.
+    let stdin_is_terminal = stdin_is_terminal && !streams[0].metadata()?.is_file();
+    let stdout_is_terminal = stdout_is_terminal && !streams[1].metadata()?.is_file();
+    Ok(Arc::new(Context {
+        args,
+        streams,
+        stdin_is_terminal,
+        stdout_is_terminal,
+        output_lock: Mutex::new(()),
+        messages: AtomicBool::new(true),
+        ignore_messages: AtomicBool::new(true),
+        errored: AtomicBool::new(false),
+        log_level: AtomicUsize::new(log::LevelFilter::Warn as usize),
+    }))
+}
+fn stream(index: usize) -> File {
+    context().streams[index]
+        .try_clone()
+        .unwrap_or_else(|_| std::panic::resume_unwind(Box::new(2i32)))
+}
+pub(crate) fn stdin() -> File {
+    stream(0)
+}
+pub(crate) fn stdout() -> File {
+    stream(1)
+}
+pub(crate) fn stderr() -> File {
+    stream(2)
+}
+pub(crate) fn stdout_is_terminal() -> bool {
+    context().stdout_is_terminal
+}
+pub(crate) fn readable_stdin() -> bool {
+    let input = stdin();
+    !context().stdin_is_terminal
+        && input.metadata().is_ok_and(|m| {
+            let t = m.file_type();
+            t.is_file() || t.is_fifo() || t.is_socket()
+        })
+}
+fn colors(choice: termcolor::ColorChoice) -> bool {
+    match choice {
+        termcolor::ColorChoice::Never => false,
+        termcolor::ColorChoice::Always
+        | termcolor::ColorChoice::AlwaysAnsi => true,
+        termcolor::ColorChoice::Auto => {
+            stdout_is_terminal()
+                && std::env::var_os("NO_COLOR").is_none()
+                && std::env::var_os("TERM").is_some_and(|s| s != "dumb")
+        }
+    }
+}
+pub(crate) fn writer(
+    choice: termcolor::ColorChoice,
+    line: bool,
+) -> Box<dyn termcolor::WriteColor + Send> {
+    let out: Box<dyn Write + Send> = if line {
+        Box::new(io::LineWriter::new(stdout()))
+    } else {
+        Box::new(io::BufWriter::new(stdout()))
+    };
+    if colors(choice) {
+        Box::new(termcolor::Ansi::new(out))
+    } else {
+        Box::new(termcolor::NoColor::new(out))
+    }
+}
+
+/// Keep upstream parallel search buffers and serialize only this invocation's writes.
+pub(crate) struct BufferWriter {
+    context: Arc<Context>,
+    output: Mutex<(File, bool)>,
+    separator: Option<Vec<u8>>,
+    color: bool,
+}
+impl BufferWriter {
+    pub(crate) fn new(
+        choice: termcolor::ColorChoice,
+        separator: Option<Vec<u8>>,
+    ) -> Self {
+        Self {
+            context: context(),
+            output: Mutex::new((stdout(), false)),
+            separator,
+            color: colors(choice),
+        }
+    }
+    pub(crate) fn buffer(&self) -> termcolor::Buffer {
+        if self.color {
+            termcolor::Buffer::ansi()
+        } else {
+            termcolor::Buffer::no_color()
+        }
+    }
+    pub(crate) fn print(&self, buffer: &termcolor::Buffer) -> io::Result<()> {
+        if buffer.is_empty() {
+            return Ok(());
+        }
+        let _lock = self.context.output_lock.lock().unwrap();
+        let mut state = self.output.lock().unwrap();
+        if state.1 {
+            if let Some(ref sep) = self.separator {
+                state.0.write_all(sep)?;
+                state.0.write_all(b"\n")?;
+            }
+        }
+        state.0.write_all(buffer.as_slice())?;
+        state.1 = true;
+        Ok(())
+    }
+}
