+// Darwin has no POSIX timer_create. Recheck wall time after bounded Tokio waits.
+#[cfg(target_vendor = "apple")]
+pub async fn sleep_until<Tz: chrono::TimeZone>(time: DateTime<Tz>) -> Result<()> {
+    let deadline = time.with_timezone(&Utc);
+    loop {
+        let remaining = deadline.signed_duration_since(Utc::now());
+        let Ok(duration) = remaining.to_std() else { return Ok(()); };
+        if duration.is_zero() { return Ok(()); }
+        tokio::time::sleep(duration.min(std::time::Duration::from_secs(1))).await;
+    }
+}
