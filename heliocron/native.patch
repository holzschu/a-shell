new file mode 100644
index 0000000..b5485b4
--- /dev/null
+++ w/src/native.rs
@@ -0,0 +1,45 @@
+use std::{ffi::{c_char, CStr, OsString}, io::Write, os::{fd::BorrowedFd, unix::ffi::OsStrExt}};
+use clap::Parser;
+use crate::{calc, cli, domain, subcommands};
+
+// The host owns process lifetime and streams; invocation state stays local.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn heliocron_embedded_run(argc: i32, argv: *const *const c_char, output: i32, errors: i32) -> i32 {
+    if argc < 1 || argv.is_null() { return 2; }
+    let Ok(stdout) = (unsafe { BorrowedFd::borrow_raw(output) }).try_clone_to_owned() else { return 1; };
+    let Ok(stderr) = (unsafe { BorrowedFd::borrow_raw(errors) }).try_clone_to_owned() else { return 1; };
+    let mut stdout = std::fs::File::from(stdout);
+    let mut stderr = std::fs::File::from(stderr);
+    let args: Vec<OsString> = (0..argc).map(|i| {
+        let bytes = unsafe { CStr::from_ptr(*argv.add(i as usize)) }.to_bytes();
+        std::ffi::OsStr::from_bytes(bytes).to_owned()
+    }).collect();
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let args = match cli::Cli::try_parse_from(args) {
+            Ok(args) => args,
+            Err(error) => {
+                let status = if error.use_stderr() { 2 } else { 0 };
+                let stream = if error.use_stderr() { &mut stderr } else { &mut stdout };
+                let _ = write!(stream, "{error}");
+                return status;
+            }
+        };
+        let result = (|| -> Result<(), Box<dyn std::error::Error>> {
+            let config = cli::parse_config_from(args, &mut stderr)?;
+            let calculations = calc::SolarCalculations::new(config.date, config.coordinates);
+            match config.action {
+                domain::Action::Report { json } => subcommands::display_report(calculations, json, &mut stdout)?,
+                domain::Action::Wait { event, offset, run_missed_task } => {
+                    let runtime = tokio::runtime::Builder::new_current_thread().enable_time().build()?;
+                    runtime.block_on(subcommands::wait(event, offset, calculations, run_missed_task, &mut stdout))?;
+                }
+                domain::Action::Poll { watch, json } => subcommands::poll(calculations, watch, json, &mut stdout)?,
+            }
+            Ok(())
+        })();
+        match result {
+            Ok(()) => 0,
+            Err(error) => { let _ = writeln!(stderr, "{error}"); 1 }
+        }
+    })).unwrap_or(1)
+}
